# --- Storage / auth backend switches -----------------------------------
# DB_BACKEND=firebase (default) -> Firestore, as before.
# DB_BACKEND=sqlite -> local file at ./data/crickscore.sqlite, no Google
#   Cloud project needed. Mirror the value with NEXT_PUBLIC_DB_BACKEND so the
#   browser knows to poll for live-score updates instead of using a Firestore
#   realtime listener.
DB_BACKEND=firebase
NEXT_PUBLIC_DB_BACKEND=firebase

# AUTH_MODE=firebase (default) -> Firebase Auth login/session, as before.
# AUTH_MODE=none -> no login screen; every request is treated as a single
#   fixed local user (uid="local"). Mirror the value with
#   NEXT_PUBLIC_AUTH_MODE so the client skips Firebase Auth entirely.
#   Pairs well with DB_BACKEND=sqlite for a fully offline/local setup.
AUTH_MODE=firebase
NEXT_PUBLIC_AUTH_MODE=firebase

# Firebase client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — never expose to the browser)
# Either naming style works:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=

# AUTH_DOMAIN:
# - Local: <projectId>.firebaseapp.com (popup sign-in)
# - Vercel production: your app host, e.g. cricket-scoring-app-pink.vercel.app
#   (requires /__/auth rewrite in next.config.mjs + OAuth redirect URI on that host)
#
# Enable in Firebase Console:
# - Authentication → Sign-in method → Email/Password
# - Authentication → Sign-in method → Google
# - Authentication → Settings → Authorized domains (localhost + production host)
#
# After deploying auth, wipe legacy global Firestore collections
# (players, teams, tournaments, live_match_draft, saved_matches, meta)
# Data is now stored under users/{uid}/...
# Optional one-shot: npx tsx scripts/wipe-legacy-collections.ts
